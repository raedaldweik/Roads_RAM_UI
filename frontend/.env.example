# Frontend environment (Vite) — copy to .env.local for local dev.
#
# These are only needed to render the interactive TomTom map (MapCard).
# The rest of the app works without them.

# TomTom API key used by the browser to load map tiles + live traffic tiles.
# Use a key restricted to your workshop domain. Required for the default
# (raster) basemap and the traffic overlay.
VITE_TOMTOM_API_KEY=

# Optional: a TomTom (or any MapLibre) vector STYLE URL. When set, the map uses
# this style instead of the default raster basemap — enabling 3D buildings and
# full theming. If the URL has no `key=` param, VITE_TOMTOM_API_KEY is appended.
# Example (TomTom vector style):
#   https://api.tomtom.com/style/1/style/*?map=basic_main&traffic_incidents=...
VITE_MAP_STYLE_URL=
